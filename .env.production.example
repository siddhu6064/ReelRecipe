# ─────────────────────────────────────────────────────────────────────────────
# ReelRecipes — Production Environment Variables
# Copy to apps/api/.env on Railway (via Service Variables UI or CLI)
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
ENV=production
VERSION=1.0.0
CORS_ORIGINS=https://reelrecipes.app,https://www.reelrecipes.app

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get from Atlas → Deployment → Database → Connect → Drivers
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URL=mongodb+srv://reelrecipes:<password>@cluster0.xxxxx.mongodb.net
MONGODB_DB=reelrecipes_production

# ── Redis (Railway) ───────────────────────────────────────────────────────────
# Railway auto-injects $REDIS_URL when you add a Redis service
REDIS_URL=${{Redis.REDIS_URL}}

# ── Clerk Auth ────────────────────────────────────────────────────────────────
# From Clerk Dashboard → API Keys (use Production instance keys)
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...
# From Clerk Dashboard → Webhooks → Add endpoint
# Endpoint: https://reelrecipes-api.railway.app/api/clerk/webhooks
CLERK_WEBHOOK_SECRET=whsec_...

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_EXTRACTION_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── YouTube Data API v3 ───────────────────────────────────────────────────────
# Google Cloud Console → Enable YouTube Data API v3 → Create API key
# Restrict key to YouTube Data API v3 only
YOUTUBE_API_KEY=AIza...

# ── Nutritionix ──────────────────────────────────────────────────────────────
# https://developer.nutritionix.com → Create app → copy App ID + API Key
NUTRITIONIX_APP_ID=xxxxxxxx
NUTRITIONIX_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Sentry ────────────────────────────────────────────────────────────────────
# sentry.io → New Project → FastAPI → copy DSN
SENTRY_DSN=https://xxx@oxx.ingest.sentry.io/xxxxx
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_RATE=0.1

# ── PostHog ───────────────────────────────────────────────────────────────────
# app.posthog.com → Project Settings → Project API Key
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com

# ─────────────────────────────────────────────────────────────────────────────
# Vercel (apps/web) — set these in Vercel project settings
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_URL=https://reelrecipes-api.railway.app
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# ─────────────────────────────────────────────────────────────────────────────
# EAS Build (apps/mobile) — set these in eas.json env or Expo dashboard
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=https://reelrecipes-api.railway.app
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
