# ─────────────────────────────────────────────────────────────
# ReelRecipes API — Environment Variables
# Copy to .env and fill in your values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
ENV=local                          # local | staging | production
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ── MongoDB Atlas ─────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=reelrecipes_local

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Clerk Auth ────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_EXTRACTION_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── YouTube Data API v3 ───────────────────────────────────────
YOUTUBE_API_KEY=AIza...

# ── Nutritionix ───────────────────────────────────────────────
# https://developer.nutritionix.com — free tier: 500 calls/day
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=

# ── Observability ─────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_API_KEY=
