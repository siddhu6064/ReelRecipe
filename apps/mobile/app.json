{
  "expo": {
    "name": "ReelRecipes",
    "slug": "reelrecipes",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "assetBundlePatterns": ["**/*"],
    "scheme": "reelrecipes",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.reelrecipes.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan barcodes to add pantry ingredients.",
        "NSMicrophoneUsageDescription": "Not used.",
        "NSPhotoLibraryUsageDescription": "Not used."
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.reelrecipes.app"]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f0f"
      },
      "package": "com.reelrecipes.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "reelrecipes.app" }],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [{ "mimeType": "text/plain" }]
        },
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [{ "mimeType": "video/*" }]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ff6b35",
          "androidMode": "default",
          "androidCollapsedTitle": "ReelRecipes"
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          },
          "androidMultiIntentFilters": ["text/plain"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan barcodes to add pantry ingredients."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
